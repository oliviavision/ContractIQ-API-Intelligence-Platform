# Copy this file to .env and replace the placeholder values.
# Never commit .env or real credentials.

RAILS_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_with_your_postgres_password
DB_NAME=contractiq_development
TEST_DB_NAME=contractiq_test
DB_NAME_PRODUCTION=contractiq_production

# Generate a secret with: bin/rails secret
SECRET_KEY_BASE=replace_with_output_of_bin_rails_secret

# Redis is used by Sidekiq/background jobs.
REDIS_URL=redis://localhost:6379/0

# Vite development server
FRONTEND_ORIGIN=http://localhost:5173
